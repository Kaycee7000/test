{
  "annotations": {"list": []},
  "panels": [
    {
      "type": "graph",
      "title": "CPU Usage (pod)",
      "targets": [
        {"expr": "sum(rate(container_cpu_usage_seconds_total{pod=~\"echo-app.*\"}[5m])) by (pod)", "legendFormat": "{{pod}}"}
      ]
    },
    {
      "type": "graph",
      "title": "Memory Usage (pod)",
      "targets": [
        {"expr": "container_memory_usage_bytes{pod=~\"echo-app.*\"}", "legendFormat": "{{pod}}"}
      ]
    },
    {
      "type": "stat",
      "title": "Pod Status (Ready)",
      "targets": [
        {"expr": "sum(kube_pod_status_ready{condition=\"true\",namespace=\"echo-dev\"}) by (pod)", "legendFormat": "{{pod}}"}
      ]
    }
  ],
  "schemaVersion": 16,
  "title": "Echo App - CI/CD Monitoring",
  "version": 1
}
